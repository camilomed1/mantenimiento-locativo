# Copy to .env and change every secret. .env must never be committed.

NODE_ENV=development

# PostgreSQL 16
POSTGRES_USER=mantenimiento
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=mantenimiento_locativo
POSTGRES_PORT=5432

# Redis (BullMQ queues)
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# MinIO (S3-compatible object storage for photos)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET_EVIDENCIAS=evidencias
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_URL=http://localhost:9000

# Backend
BACKEND_PORT=3000
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
CLOCK_SKEW_TOLERANCE_SECONDS=300
MAX_OFFLINE_HOURS=72
CORS_ORIGINS=http://localhost:5173
